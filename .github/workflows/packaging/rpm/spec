Name:           linupdate
Version:        __VERSION__
Release:        stable
Summary:        Linupdate 3 (python version) - Packages updater and Repomanager client side agent

# Built on EL8 for cross-distro tests; exclude EL-specific autogenerated interpreter requirement.
%global __requires_exclude ^/usr/libexec/platform-python$

BuildArch:      noarch
License:        GPL-3.0
URL:            https://github.com/lbr38/linupdate

Requires: virt-what
Requires: net-tools
Requires: bind-utils
Requires: python3
Requires: python3-tabulate
Requires: python3-colorama
Requires: python3-dateutil
Requires: python3-yaml
Requires: python3-dateutil
Requires: python3-simplejson
Requires: python3-distro
Requires: python3-requests
Requires: python3-inotify
Requires: python3-websocket-client
Requires: python3-psutil
Requires: python3-rich

%description
Linupdate 3 (python version) - Packages updater and Repomanager client side agent

#
# Scriptlets doc: https://docs.fedoraproject.org/en-US/packaging-guidelines/Scriptlets/#_syntax
#

%pre
# Root only directory of the linupdate temporary files (never use /tmp, writable by any user)
TMP_DIR="/opt/linupdate/tmp"
BACKUP_DIR="${TMP_DIR}/upgrade-backup"

# Save current configuration files if exists (restored by the post-install scriptlet)
for file in linupdate.yml update.yml; do
    if [ -f "/etc/linupdate/${file}" ];then
        mkdir -p "$BACKUP_DIR"
        chmod 700 "$BACKUP_DIR"
        cp "/etc/linupdate/${file}" "${BACKUP_DIR}/${file}"
    fi
done

# Delete service symlink if exists
rm -f /etc/systemd/system/linupdate.service

# Only if systemd is installed and actually running as init (not the case on github runners)
if [ -f "/usr/bin/systemctl" ] && [ -d "/run/systemd/system" ];then
    # Stop service if started
    if /usr/bin/systemctl is-active --quiet linupdate;then
        # Do not stop if a restart has been requested: linupdate is updating itself, the service will restart itself
        # (/tmp/linupdate.restart-needed is the request file of linupdate <= 3.17.4)
        if [ ! -f "${TMP_DIR}/restart-needed" ] && [ ! -f "/tmp/linupdate.restart-needed" ];then
            /usr/bin/systemctl stop --quiet linupdate
        fi
    fi
fi

%install
# Copy local files to the rpm build directory
install -m 0700 -d $RPM_BUILD_ROOT/opt/
install -m 0700 -d $RPM_BUILD_ROOT/etc/
install -d $RPM_BUILD_ROOT/lib/systemd/system/
cp -r /opt/linupdate $RPM_BUILD_ROOT/opt/
cp -r /etc/linupdate $RPM_BUILD_ROOT/etc/
cp /lib/systemd/system/linupdate.service $RPM_BUILD_ROOT/lib/systemd/system/linupdate.service

%post
SERVICE="/opt/linupdate/service.py"

# Root only directory of the linupdate temporary files (never use /tmp, writable by any user)
TMP_DIR="/opt/linupdate/tmp"
BACKUP_DIR="${TMP_DIR}/upgrade-backup"

# Restore configuration files saved by the pre-install scriptlet if exists
for file in linupdate.yml update.yml; do
    if [ -f "${BACKUP_DIR}/${file}" ];then
        rm -f "/etc/linupdate/${file}"
        mv "${BACKUP_DIR}/${file}" "/etc/linupdate/${file}"
    fi
done
rmdir "$BACKUP_DIR" 2> /dev/null || true

# If no configuration files exists, copy default
if [ ! -f "/etc/linupdate/linupdate.yml" ];then
    cp /opt/linupdate/templates/linupdate.template.yml /etc/linupdate/linupdate.yml
fi
if [ ! -f "/etc/linupdate/update.yml" ];then
    cp /opt/linupdate/templates/update.template.yml /etc/linupdate/update.yml
fi

# Create a symlink to main script
ln -sf /opt/linupdate/linupdate.py /usr/bin/linupdate

# Set permissions
chmod 750 /etc/linupdate
chmod 750 /opt/linupdate

# Only if systemd is installed and actually running as init (not the case on github runners)
if [ -f "/usr/bin/systemctl" ] && [ -d "/run/systemd/system" ];then
    # Copy systemd unit file if not exists
    if [ ! -f "/lib/systemd/system/linupdate.service" ];then
        cp /opt/linupdate/templates/linupdate.systemd.template /lib/systemd/system/linupdate.service
    fi

    # Replace systemd unit file if some options are missing
    if  ! grep -q "^CPUQuota"       /lib/systemd/system/linupdate.service || \
        ! grep -q "^CPUWeight"      /lib/systemd/system/linupdate.service || \
        ! grep -q "^MemoryMax"      /lib/systemd/system/linupdate.service || \
        ! grep -q "^OOMScoreAdjust" /lib/systemd/system/linupdate.service;
    then
        \cp /opt/linupdate/templates/linupdate.systemd.template /lib/systemd/system/linupdate.service
    fi

    chmod 550 "$SERVICE"
    chown root:root "$SERVICE"

    # Clean old directories
    rm /opt/linupdate/agents-enabled -rf
    rm /opt/linupdate/mods-enabled -rf
    rm /opt/linupdate/mods-available -rf
    rm /opt/linupdate/service -rf

    /usr/bin/systemctl enable linupdate
    /usr/bin/systemctl --quiet daemon-reload

    # Restart or start service
    if /usr/bin/systemctl is-active --quiet linupdate;then
        # Do not restart if a restart has been requested: linupdate is updating itself, the service will restart itself
        # (/tmp/linupdate.restart-needed is the request file of linupdate <= 3.17.4)
        if [ ! -f "${TMP_DIR}/restart-needed" ] && [ ! -f "/tmp/linupdate.restart-needed" ];then
            /usr/bin/systemctl restart --quiet linupdate
        fi
    else
        /usr/bin/systemctl start --quiet linupdate
    fi
fi

%posttrans
# Clean the controllers directories of linupdate <= 3.17.4 (renamed to lowercase): rpm removes their files
# but not the directories themselves, which still contain the python cache created at runtime.
# Done in %posttrans because the files of the old package are only removed after the %post scriptlet of the new one.
for dir in App Module Package Service; do
    rm -rf "/opt/linupdate/src/controllers/${dir}"
done
exit 0

%preun
# Package removal ($1 = 0, not on upgrade): stop and disable the linupdate service
if [ "$1" -eq 0 ];then
    if command -v systemctl > /dev/null;then
        # Only stop the service if systemd is actually running as init (not the case in containers)
        if [ -d "/run/systemd/system" ];then
            systemctl stop linupdate || true
        fi

        # Disabling the unit works offline (no running systemd needed)
        systemctl disable --quiet linupdate || true
    fi
fi
exit 0

%postun
# Package removal ($1 = 0, not on upgrade): remove what the post-install scriptlet and linupdate created outside of the package files.
# The configuration and the logs are kept.
if [ "$1" -eq 0 ];then
    if [ -d "/run/systemd/system" ] && command -v systemctl > /dev/null;then
        systemctl daemon-reload || true
    fi

    # Symlink created by the post-install scriptlet
    if [ "$(readlink /usr/bin/linupdate)" = "/opt/linupdate/linupdate.py" ];then
        rm -f /usr/bin/linupdate
    fi

    # Files created at runtime: python cache, locks, temporary files and last update date
    if [ -d "/opt/linupdate" ];then
        find /opt/linupdate -type d -name __pycache__ -prune -exec rm -rf {} +
        rm -rf /opt/linupdate/locks /opt/linupdate/tmp /opt/linupdate/last-update
        find /opt/linupdate -depth -type d -empty -delete
    fi
fi
exit 0

%files
/opt/linupdate/
/etc/linupdate/
/lib/systemd/system/linupdate.service %config(noreplace)

# Entry of the current version generated and appended by the CI from CHANGELOG.md (.github/scripts/generate-changelog.sh)
%changelog
